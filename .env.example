# Project branding and container identity. For an existing installation, preserve its Compose
# project name and bind-mount paths; use the router-only publisher for renaming (docs/RENAMING.md).
ROUTER_IMAGE=llm-router:latest
ROUTER_CONTAINER_NAME=llm-router

# Router listener. Keep ROUTER_PUBLIC_PORT at 11435 during transition, then move to 11434 after raw Ollama is private.
HOST=0.0.0.0
PORT=11434
ROUTER_BIND_IP=192.168.1.21
ROUTER_PUBLIC_PORT=11435

# Raw Ollama backend. In the current topology this is normally reachable on the shared Docker network.
OLLAMA_UPSTREAM_URL=http://ollama:11434
OLLAMA_UPSTREAM_TIMEOUT_MS=30000
# Inactivity only; healthy generation has no total deadline.
GENERATION_STALL_TIMEOUT_MS=120000
RESPONSES_CONTEXT_SHIFT=false

# Source of truth for the deployed/prewarmed model. The profile deploy script should write this JSON file.
ACTIVE_MODEL_FILE=/app/runtime/active-model.json
# Temporary fallback only. Prefer ACTIVE_MODEL_FILE.
ACTIVE_MODEL=

# Stable public model ID. Clients should configure this alias instead of a physical Ollama model.
ROUTER_MODEL_ALIAS=local-active
# TTL for /api/ps and /api/show enrichment used by GET /v1/models, in milliseconds.
ROUTER_MODEL_METADATA_TTL_MS=5000

# Core safety policy.
MODEL_POLICY_MODE=active-only
ALLOWED_MODELS=
# The exact ROUTER_MODEL_ALIAS always resolves to the active marker. This broader option also rewrites other names.
REWRITE_REQUESTED_MODEL_TO_ACTIVE=false
FORCE_KEEP_ALIVE=-1
# Optional cross-protocol default when a request omits think/reasoning effort.
# Leave blank to preserve endpoint defaults: Responses disables thinking; native Ollama leaves it to the model.
# Values: true, false/none, minimal/low, medium, high, xhigh/max, or model-default.
DEFAULT_THINK=
PROTECTED_MODEL_ENDPOINTS=/api/chat,/api/generate,/api/embed,/api/embeddings
USE_ACTIVE_MODEL_WHEN_MISSING=false
ALLOW_MODEL_MANAGEMENT=false

# Admin UI/API. If ADMIN_TOKEN is set, admin endpoints require Authorization: Bearer <token> or X-Admin-Token.
ADMIN_TOKEN=change-me-before-lan-exposure
ADMIN_SESSION_HEADER=X-Admin-Token

# Request persistence and logs.
DATA_DIR=/app/data
REQUEST_HISTORY_LIMIT=500
EVENT_HISTORY_LIMIT=500
# Persisted metadata caps, in bytes. Positive integers only.
REQUEST_LOG_MAX_BYTES=5242880
EVENT_LOG_MAX_BYTES=5242880
# Closed generation archives expire by age or total bytes, whichever is reached first.
# Active journals are protected and consume additional space.
GENERATION_RETENTION_DAYS=7
GENERATION_MAX_BYTES=1073741824
# 0 disables the router-level request body cap. Set a positive byte count to restore one.
MAX_BODY_BYTES=0
PROMPT_LOGGING=metadata

# Optional GPU telemetry. Requires nvidia-smi inside the container or a mounted compatible binary.
ENABLE_NVIDIA_SMI=false
NVIDIA_SMI_BIN=nvidia-smi
GPU_TELEMETRY_TIMEOUT_MS=2500

# Optional unified model directory mount. The router does not load models directly, but the path is visible in admin config.
UNIFIED_MODELS_DIR=/home/astigmatism/ai-models
MODELS_DIR_IN_CONTAINER=/models
