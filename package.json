{
  "name": "llm-router",
  "version": "0.1.0",
  "private": true,
  "description": "LLM router for llama.cpp and Ollama backends, with OpenAI-compatible APIs, an admin dashboard, request history, and telemetry.",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "NODE_ENV=development node --watch src/server.js",
    "test": "node --test test/*.test.js",
    "lint:syntax": "node scripts/lint-syntax.mjs"
  },
  "keywords": [
    "llm",
    "router",
    "llama.cpp",
    "openai-compatible",
    "ollama",
    "proxy",
